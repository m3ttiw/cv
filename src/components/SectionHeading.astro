---
import LocaleText from './LocaleText.astro';

interface Props {
  labelIt: string;
  labelEn: string;
  titleIt: string;
  titleEn: string;
  id?: string;
}

const { labelIt, labelEn, titleIt, titleEn, id } = Astro.props;
---

<div class="section-heading" id={id}>
  <p class="section-kicker"><LocaleText it={labelIt} en={labelEn} /></p>
  <h2><LocaleText it={titleIt} en={titleEn} /></h2>
</div>
