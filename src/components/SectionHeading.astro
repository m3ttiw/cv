---
import LocaleText from './LocaleText.astro';

interface Props {
  labelIt: string;
  labelEn: string;
  titleIt: string;
  titleEn: string;
  bodyIt?: string;
  bodyEn?: string;
  id?: string;
  /** Section number shown before the label, e.g. `01`. */
  index?: string;
}

const { labelIt, labelEn, titleIt, titleEn, bodyIt, bodyEn, id, index } = Astro.props;
---

<div class="section-heading reveal">
  <p class="section-kicker">
    {index && <span class="section-index">{index}</span>}
    <LocaleText it={labelIt} en={labelEn} />
  </p>
  <h2 id={id}><LocaleText it={titleIt} en={titleEn} /></h2>
  {bodyIt && bodyEn && (
    <p class="section-body"><LocaleText it={bodyIt} en={bodyEn} /></p>
  )}
</div>
