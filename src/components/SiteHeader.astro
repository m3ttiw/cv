---
import LocaleText from './LocaleText.astro';
import { cvContent } from '../data/cv';
import { navSections as navLinks } from '../data/navigation';
import { withBase } from '../utils/url';

interface Props {
  /** `home` uses in-page anchors, `page` links back to the homepage sections. */
  variant?: 'home' | 'page';
}

const { variant = 'home' } = Astro.props;
const it = cvContent.it;
const prefix = variant === 'home' ? '' : withBase('');
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href={variant === 'home' ? '#top' : withBase('')} aria-label={`${it.name} — home`}>
      <span class="brand-mark" aria-hidden="true">{it.shortName}</span>
      <span class="brand-name">{it.name}</span>
    </a>

    <nav class="site-nav" aria-label="Menu">
      {navLinks.map((link) => (
        <a href={`${prefix}#${link.id}`}><LocaleText it={link.it} en={link.en} /></a>
      ))}
    </nav>

    <div class="header-tools">
      <button class="palette-trigger" type="button" data-palette-open aria-label={it.palette.open}>
        <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <span class="palette-trigger-label"><LocaleText it="Cerca" en="Search" /></span>
        <kbd data-shortcut-label>Ctrl K</kbd>
      </button>
      <button
        class="tool-button"
        type="button"
        data-locale-toggle
        aria-label="Switch to English"
      >EN</button>
      <button
        class="tool-button"
        type="button"
        data-theme-toggle
        aria-label="Cambia tema"
        aria-pressed="false"
      >
        <svg class="icon-sun" aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><circle cx="10" cy="10" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 1.5v2.2M10 16.3v2.2M1.5 10h2.2M16.3 10h2.2M4 4l1.5 1.5M14.5 14.5 16 16M4 16l1.5-1.5M14.5 5.5 16 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <svg class="icon-moon" aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M16.5 12.4A7 7 0 0 1 7.6 3.5a7 7 0 1 0 8.9 8.9Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      </button>
      <button
        class="tool-button menu-toggle"
        type="button"
        data-menu-toggle
        aria-controls="mobile-navigation"
        aria-expanded="false"
        aria-label="Menu"
      >
        <span class="menu-toggle-icon" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-navigation" class="mobile-nav" aria-label="Menu mobile">
    {navLinks.map((link, index) => (
      <a href={`${prefix}#${link.id}`} style={`--i:${index}`}>
        <span class="mobile-nav-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <LocaleText it={link.it} en={link.en} />
      </a>
    ))}
  </nav>
</header>
