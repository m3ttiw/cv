---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroLens from '../components/HeroLens.astro';
import LocaleText from '../components/LocaleText.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { cvContent } from '../data/cv';
import { projectGroups, projectsInGroup } from '../data/projects';

const it = cvContent.it;
const en = cvContent.en;

const serviceIcons = [
  // UI/UX: layout frame
  '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9h18M9 9v11"/>',
  // Front-end: code brackets
  '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/>',
  // AI & automation: spark + loop
  '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6.3 6.3l2.5 2.5M15.2 15.2l2.5 2.5M6.3 17.7l2.5-2.5M15.2 8.8l2.5-2.5"/><circle cx="12" cy="12" r="2.2"/>',
];

const marquee = [
  'UI design', 'UX research', 'Design systems', 'Prototyping', 'Angular', 'TypeScript',
  'Accessibility', 'LLM', 'AI agents', 'Workflow automation', 'Computer vision', 'Astro',
];
---

<BaseLayout canonicalPath="" variant="home">
  <SiteHeader variant="home" />

  <main id="main-content">
    <!-- Hero -->
    <section class="hero shell" id="top" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="status-pill">
          <span class="status-dot" aria-hidden="true"></span>
          <LocaleText it={it.status} en={en.status} />
          <span class="status-sep" aria-hidden="true">·</span>
          <LocaleText it={it.location} en={en.location} />
        </p>

        <p class="hero-kicker"><span class="sr-only">{it.name} — </span>{it.hero.kicker}</p>

        <h1 class="hero-title" id="hero-title">
          <span data-locale="it">{it.hero.titleStart} <em>{it.hero.titleEmphasis}</em> {it.hero.titleEnd}</span>
          <span data-locale="en">{en.hero.titleStart} <em>{en.hero.titleEmphasis}</em> {en.hero.titleEnd}</span>
        </h1>

        <p class="hero-lead"><LocaleText it={it.hero.lead} en={en.hero.lead} /></p>

        <div class="hero-actions">
          <a class="button button-primary" href="#projects">
            <LocaleText it={it.hero.ctaPrimary} en={en.hero.ctaPrimary} />
            <span aria-hidden="true">↓</span>
          </a>
          <a class="button button-ghost" href="#contact">
            <LocaleText it={it.hero.ctaSecondary} en={en.hero.ctaSecondary} />
          </a>
        </div>

        <dl class="hero-facts">
          {it.facts.map((fact, index) => (
            <div>
              <dt><LocaleText it={fact.label} en={en.facts[index].label} /></dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="hero-visual">
        <HeroLens />
      </div>
    </section>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <ul>
            {marquee.map((word) => <li>{word}</li>)}
          </ul>
        ))}
      </div>
    </div>

    <!-- Services -->
    <section class="section shell" id="services" aria-labelledby="services-title">
      <SectionHeading
        id="services-title"
        index="01"
        labelIt={it.sections.servicesLabel}
        labelEn={en.sections.servicesLabel}
        titleIt={it.sections.servicesTitle}
        titleEn={en.sections.servicesTitle}
        bodyIt={it.sections.servicesBody}
        bodyEn={en.sections.servicesBody}
      />

      <div class="services-grid">
        {it.services.map((service, index) => {
          const serviceEn = en.services[index];
          return (
            <article class="service-card reveal" style={`--reveal-index:${index}`} data-spotlight>
              <div class="service-top">
                <svg class="service-icon" aria-hidden="true" viewBox="0 0 24 24" width="28" height="28" set:html={serviceIcons[index]} />
                <span class="service-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3><LocaleText it={service.title} en={serviceEn.title} /></h3>
              <p><LocaleText it={service.body} en={serviceEn.body} /></p>
              <ul class="tag-list">
                {service.tags.map((tag, tagIndex) => (
                  <li><LocaleText it={tag} en={serviceEn.tags[tagIndex] ?? tag} /></li>
                ))}
              </ul>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Projects -->
    <section class="section shell" id="projects" aria-labelledby="projects-title">
      <SectionHeading
        id="projects-title"
        index="02"
        labelIt={it.sections.projectsLabel}
        labelEn={en.sections.projectsLabel}
        titleIt={it.sections.projectsTitle}
        titleEn={en.sections.projectsTitle}
        bodyIt={it.sections.projectsBody}
        bodyEn={en.sections.projectsBody}
      />

      <div class="project-groups">
        {projectGroups.map((group) => {
          const items = projectsInGroup(group);
          return (
            <section class="project-group" aria-labelledby={`projects-${group}`}>
              <header class="project-group-head reveal">
                <h3 id={`projects-${group}`}>
                  <LocaleText it={it.projectCard.groups[group].title} en={en.projectCard.groups[group].title} />
                </h3>
                <span class="project-group-count" aria-hidden="true">{String(items.length).padStart(2, '0')}</span>
                <p>
                  <LocaleText it={it.projectCard.groups[group].body} en={en.projectCard.groups[group].body} />
                </p>
              </header>
              <ul class="project-grid">
                {items.map((project) => (
                  <li class="reveal">
                    <ProjectCard project={project} />
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </div>
    </section>

    <!-- Process -->
    <section class="section section-process" id="process" aria-labelledby="process-title">
      <div class="shell process-layout">
        <div class="process-aside">
          <SectionHeading
            id="process-title"
            index="03"
            labelIt={it.sections.processLabel}
            labelEn={en.sections.processLabel}
            titleIt={it.sections.processTitle}
            titleEn={en.sections.processTitle}
            bodyIt={it.sections.processBody}
            bodyEn={en.sections.processBody}
          />
          <div class="process-counter" aria-hidden="true">
            <span class="process-counter-value" data-process-current>01</span>
            <span class="process-counter-total">/ {String(it.process.length).padStart(2, '0')}</span>
            <span class="process-meter"><span data-process-meter></span></span>
          </div>
        </div>

        <ol class="process-steps">
          {it.process.map((step, index) => {
            const stepEn = en.process[index];
            return (
              <li class="process-step" data-process-step={index}>
                <span class="process-step-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3><LocaleText it={step.title} en={stepEn.title} /></h3>
                  <p><LocaleText it={step.body} en={stepEn.body} /></p>
                  <p class="process-output">
                    <span class="process-output-label" aria-hidden="true">→</span>
                    <LocaleText it={step.output} en={stepEn.output} />
                  </p>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <!-- Journey + tools -->
    <section class="section shell" id="journey" aria-labelledby="journey-title">
      <SectionHeading
        id="journey-title"
        index="04"
        labelIt={it.sections.journeyLabel}
        labelEn={en.sections.journeyLabel}
        titleIt={it.sections.journeyTitle}
        titleEn={en.sections.journeyTitle}
      />

      <div class="journey-layout">
        <ol class="timeline">
          {it.journey.map((item, index) => {
            const itemEn = en.journey[index];
            return (
              <li class="timeline-item reveal" data-kind={item.kind} style={`--reveal-index:${index}`}>
                <div class="timeline-period">
                  <LocaleText it={item.period} en={itemEn.period} />
                </div>
                <div class="timeline-content">
                  <p class="timeline-kind">
                    {item.kind === 'education'
                      ? <LocaleText it="Formazione" en="Education" />
                      : <LocaleText it="Esperienza" en="Experience" />}
                  </p>
                  <h3><LocaleText it={item.title} en={itemEn.title} /></h3>
                  <p><LocaleText it={item.summary} en={itemEn.summary} /></p>
                  {item.bullets.length > 0 && (
                    <ul class="detail-list">
                      {item.bullets.map((bullet, bulletIndex) => (
                        <li><LocaleText it={bullet} en={itemEn.bullets[bulletIndex] ?? bullet} /></li>
                      ))}
                    </ul>
                  )}
                </div>
              </li>
            );
          })}
        </ol>

        <aside class="toolkit reveal" aria-labelledby="tools-title">
          <p class="section-kicker"><LocaleText it={it.sections.toolsLabel} en={en.sections.toolsLabel} /></p>
          <h3 id="tools-title" class="toolkit-title">
            <LocaleText it={it.sections.toolsTitle} en={en.sections.toolsTitle} />
          </h3>
          {it.tools.map((group, index) => {
            const groupEn = en.tools[index];
            return (
              <div class="toolkit-group">
                <p class="toolkit-label"><LocaleText it={group.title} en={groupEn.title} /></p>
                <ul class="tag-list">
                  {group.items.map((tool, toolIndex) => (
                    <li><LocaleText it={tool} en={groupEn.items[toolIndex] ?? tool} /></li>
                  ))}
                </ul>
              </div>
            );
          })}
        </aside>
      </div>
    </section>

    <!-- Contact -->
    <section class="section shell" id="contact" aria-labelledby="contact-title">
      <div class="contact-panel reveal">
        <div class="contact-grid" aria-hidden="true"></div>
        <p class="section-kicker">
          <span class="section-index">05</span>
          <LocaleText it={it.sections.contactLabel} en={en.sections.contactLabel} />
        </p>
        <h2 class="contact-title" id="contact-title">
          <LocaleText it={it.sections.contactTitle} en={en.sections.contactTitle} />
        </h2>
        <p class="contact-body"><LocaleText it={it.sections.contactBody} en={en.sections.contactBody} /></p>

        <ul class="contact-list">
          {it.contacts.map((contact) => (
            <li>
              <a class="contact-link" href={contact.href} target={contact.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
                <span class="contact-label">{contact.label}</span>
                <span class="contact-value">{contact.value}</span>
                <span class="contact-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>

        <p class="contact-status">
          <span class="status-dot" aria-hidden="true"></span>
          <LocaleText it={it.status} en={en.status} />
        </p>
      </div>
    </section>
  </main>

  <SiteFooter variant="home" />
</BaseLayout>
