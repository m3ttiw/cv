---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LocaleText from '../components/LocaleText.astro';
import { cvContent } from '../data/cv';

const it = cvContent.it;
const en = cvContent.en;
const contacts = it.contacts;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout>
  <header class="site-header">
    <div class="shell header-inner">
      <button
        class="tool-button menu-toggle"
        type="button"
        data-menu-toggle
        aria-controls="mobile-navigation"
        aria-expanded="false"
        aria-label="Apri menu"
      >
        <span class="menu-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="sr-only" data-menu-label>Apri menu</span>
      </button>

      <a class="brand" href="#top" aria-label="Mattia Patruno — home">
        <span class="brand-mark">MP</span>
        <span class="brand-name">Mattia Patruno</span>
      </a>

      <nav class="site-nav" aria-label="Navigazione principale">
        <a href="#projects"><LocaleText it={it.nav.projects} en={en.nav.projects} /></a>
        <a href="#profile"><LocaleText it={it.nav.profile} en={en.nav.profile} /></a>
        <a href="#experience"><LocaleText it={it.nav.experience} en={en.nav.experience} /></a>
        <a href="#contact"><LocaleText it={it.nav.contact} en={en.nav.contact} /></a>
      </nav>

      <div class="header-tools">
        <button
          class="tool-button locale-toggle"
          type="button"
          data-locale-toggle
          data-it-label="EN"
          data-en-label="IT"
          aria-label="Passa all’inglese"
          aria-pressed="false"
        >EN</button>
      </div>
    </div>
  </header>
  <nav id="mobile-navigation" class="mobile-drawer" aria-label="Navigazione mobile">
    <a href="#projects"><LocaleText it={it.nav.projects} en={en.nav.projects} /></a>
    <a href="#profile"><LocaleText it={it.nav.profile} en={en.nav.profile} /></a>
    <a href="#experience"><LocaleText it={it.nav.experience} en={en.nav.experience} /></a>
    <a href="#contact"><LocaleText it={it.nav.contact} en={en.nav.contact} /></a>
  </nav>
  <button class="menu-backdrop" type="button" data-menu-close aria-label="Chiudi menu"></button>

  <main id="main-content">
    <Hero it={it} en={en} baseUrl={baseUrl} />

    <section class="content-section shell" id="projects" aria-labelledby="projects-title">
      <p class="section-label" id="projects-title">
        <LocaleText it={it.nav.projects} en={en.nav.projects} />
      </p>

      <div class="project-slabs">
        {it.projects.map((project, index) => {
          const projectEn = en.projects[index];
          return (
            <article class="project-slab reveal" style={`--reveal-index:${index}`}>
              <h3><LocaleText it={project.title} en={projectEn.title} /></h3>
              <div class="project-frame" aria-hidden="true"></div>
              <p class="project-stack">{project.stack.join(' · ')}</p>
              {project.url ? (
                <a class="project-link" href={project.url} target="_blank" rel="noreferrer">
                  <LocaleText it={project.urlLabel ?? 'Apri progetto'} en={projectEn.urlLabel ?? 'Open project'} />
                </a>
              ) : null}
            </article>
          );
        })}
      </div>
    </section>

    <section class="content-section content-section-tight shell" id="profile" aria-labelledby="profile-title">
      <p class="section-label" id="profile-title">
        <LocaleText it={it.nav.profile} en={en.nav.profile} />
      </p>
      <p class="about-copy reveal">
        <LocaleText it={it.intro} en={en.intro} />
      </p>
    </section>

    <section class="content-section content-section-tight shell" id="experience" aria-labelledby="experience-title">
      <p class="section-label" id="experience-title">
        <LocaleText it={it.nav.experience} en={en.nav.experience} />
      </p>

      <ol class="experience-list">
        {it.experience.map((item, index) => {
          const itemEn = en.experience[index];
          return (
            <li class="experience-item reveal" style={`--reveal-index:${index}`}>
              <p class="experience-period">
                <LocaleText it={item.period} en={itemEn.period} />
              </p>
              <div class="experience-body">
                <h3><LocaleText it={item.role} en={itemEn.role} /></h3>
                <p><LocaleText it={item.summary} en={itemEn.summary} /></p>
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="content-section content-section-contact shell" id="contact" aria-labelledby="contact-title">
      <h2 id="contact-title" class="sr-only">
        <LocaleText it={it.nav.contact} en={en.nav.contact} />
      </h2>
      <p class="contact-line">
        <a href={`mailto:${contacts.email}`}>{contacts.email}</a>
        <span aria-hidden="true">·</span>
        <a href={contacts.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <span aria-hidden="true">·</span>
        <a href={contacts.github} target="_blank" rel="noreferrer">GitHub</a>
      </p>
      <p class="contact-availability">
        <LocaleText it={it.availability} en={en.availability} />
      </p>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <span>© {new Date().getFullYear()} Mattia Patruno</span>
      <a href="#top"><LocaleText it="Torna su" en="Back to top" /></a>
    </div>
  </footer>
</BaseLayout>
