---
import '../styles/global.css';
import { cvContent } from '../data/cv';

const initialContent = cvContent.it;
const canonicalUrl = Astro.site?.toString() ?? 'https://m3ttiw.github.io/cv';
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="it" data-locale="it" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="description" content={initialContent.meta.description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <title>{initialContent.meta.title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const theme = window.localStorage.getItem('cv-theme');
        const locale = window.localStorage.getItem('cv-locale');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
        if (locale === 'it' || locale === 'en') {
          document.documentElement.dataset.locale = locale;
          document.documentElement.lang = locale;
        }
      } catch {
        // Storage can be unavailable in privacy-restricted contexts; light/IT remain the fallback.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Vai al contenuto / Skip to content</a>
    <slot />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
